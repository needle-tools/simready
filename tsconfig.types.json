{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmitOnError": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [],
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "types"
  },
  "include": [
    "src/**/*.js"
  ]
}
