{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/needle-tools/simready/main/extensions/NEEDLE_simready/schema/glTF.NEEDLE_simready.schema.json",
  "title": "NEEDLE_simready glTF document extension",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/property"
    },
    {
      "if": {
        "properties": {
          "version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "metadataBuffers"
        ],
        "properties": {
          "metadataBuffers": {}
        }
      },
      "else": {
        "properties": {
          "metadataBuffers": false
        }
      }
    }
  ],
  "properties": {
    "version": {
      "enum": [
        1,
        2
      ]
    },
    "stageNode": {
      "$ref": "common.schema.json#/$defs/index",
      "description": "Index into glTF nodes; the asset-local reference root. Its ordinary glTF transform places the asset in the scene."
    },
    "snapshot": {
      "$ref": "snapshot.schema.json"
    },
    "usdMetadata": {
      "$ref": "metadata.schema.json"
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/property"
          }
        ],
        "properties": {
          "node": {
            "$ref": "common.schema.json#/$defs/index",
            "description": "Index into glTF nodes."
          },
          "path": {
            "$ref": "common.schema.json#/$defs/identity"
          },
          "body": {
            "$ref": "common.schema.json#/$defs/bodyReference"
          },
          "instance": {}
        },
        "required": [
          "node",
          "path"
        ]
      }
    },
    "mappingIssues": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/issue"
      },
      "default": []
    },
    "source": false,
    "metadataBuffers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ]
            }
          },
          "bufferView": {
            "$ref": "common.schema.json#/$defs/index"
          },
          "componentType": {
            "enum": [
              "float32",
              "float64"
            ]
          },
          "shape": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "required": [
          "path",
          "bufferView",
          "componentType",
          "shape"
        ]
      }
    }
  },
  "required": [
    "version",
    "stageNode",
    "snapshot",
    "usdMetadata",
    "bindings"
  ]
}
