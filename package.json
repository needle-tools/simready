{
  "name": "@needle-tools/simready",
  "version": "0.1.0",
  "description": "SimReady mechanisms, simulation and glTF integration for browser and headless applications",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "src",
    "types",
    "extensions",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.txt"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./rapier": {
      "types": "./types/rapier.d.ts",
      "import": "./src/rapier.js"
    },
    "./kinematics": {
      "types": "./types/kinematics.d.ts",
      "import": "./src/kinematics.js"
    },
    "./three": {
      "types": "./types/three.d.ts",
      "import": "./src/three.js"
    },
    "./gltf": {
      "types": "./types/gltf.d.ts",
      "import": "./src/gltf.js"
    },
    "./package.json": "./package.json",
    "./needle": {
      "types": "./types/needle.d.ts",
      "import": "./src/needle.js"
    },
    "./schema/*": "./extensions/NEEDLE_simready/schema/*",
    "./usd": {
      "types": "./types/usd.d.ts",
      "import": "./src/usd.js"
    }
  },
  "scripts": {
    "examples:build": "node scripts/build-extension-examples.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:packed-consumer": "node scripts/test-packed-consumer.mjs",
    "build:types": "tsc -p tsconfig.types.json",
    "prepack": "npm run build:types",
    "test:types": "npm run build:types && node scripts/test-types.mjs"
  },
  "peerDependencies": {
    "@needle-tools/engine": ">=6.0.0-alpha.7",
    "three": ">=0.160.0"
  },
  "peerDependenciesMeta": {
    "@needle-tools/engine": {
      "optional": true
    }
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@needle-tools/engine": "^6.0.0-alpha.7",
    "@playwright/test": "^1.65.0",
    "@types/three": "^0.185.1",
    "ajv": "^8.20.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "three": "^0.186.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "closed-chain-ik": "https://codeload.github.com/gkjohnson/closed-chain-ik-js/tar.gz/3e01f7ba953daea5b0388135d9390504fd4ea0e2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/needle-tools/simready.git"
  },
  "bugs": {
    "url": "https://github.com/needle-tools/simready/issues"
  }
}
